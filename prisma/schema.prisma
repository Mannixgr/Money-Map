generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile           Profile?
  incomeSources     IncomeSource[]
  recurringExpenses RecurringExpense[]
  transactions      Transaction[]
  goals             Goal[]
  categories        Category[]
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currency           String   @default("CAD")
  monthlyIncomeCents Int      @default(0)
  savingsRatePct     Int      @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
}

model IncomeSource {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amountCents Int
  cadence     String   @default("monthly") // monthly, biweekly, weekly, one-time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringExpense {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amountCents Int
  cadence     String   @default("monthly")
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amountCents Int
  categoryId  String?
  note        String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  name        String
  targetCents Int
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
